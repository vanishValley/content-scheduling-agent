{
  "name": "content-scheduling-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "素材审核与发布排期 Agent：仅保存草稿",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/*.test.js",
    "evaluate": "node scripts/evaluate.js --provider mock",
    "evaluate:live": "node --env-file-if-exists=.env scripts/evaluate.js --provider live",
    "verify": "node scripts/verify-evidence.js"
  }
}
